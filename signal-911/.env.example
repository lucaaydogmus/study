# Optional: AI-voiced callers. Copy this file to .env.local and paste your Anthropic API key,
# or paste the key in the game under Settings → AI callers (it is saved to .env.local on your computer).
# The key is only used by the local dev/preview server and is never sent to the browser.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Set to 1 to test the AI pipeline without calling the API (canned replies, no cost).
# AI_MOCK=1
